<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
        <Description>Adds an 'active' CSS class to any HTML element when its asp-page, asp-controller or asp-action matches the current route. Supports MVC and Razor Pages.</Description>
        <PackageId>ActiveTagHelper</PackageId>
        <Title>ActiveTagHelper</Title>
        <Version>2.0.0</Version>
        <Authors>Alexander Wicht</Authors>
        <RepositoryUrl>https://github.com/Ducki/ActiveTagHelper</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>aspnetcore taghelpers razor cshtml route css menu item items nav navigation navbar links link active class</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

</Project>
